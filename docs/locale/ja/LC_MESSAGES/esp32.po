#: ../../esp32/tutorial/pwm.rst:51
msgid "Example of a smooth frequency change::"
msgstr "スムーズな周波数変更の例::"

#: ../../esp32/tutorial/pwm.rst:53
msgid ""
"from utime import sleep\n"
"from machine import Pin, PWM\n"
"\n"
"F_MIN = 500\n"
"F_MAX = 1000\n"
"\n"
"f = F_MIN\n"
"delta_f = 1\n"
"\n"
"p = PWM(Pin(5), f)\n"
"print(p)\n"
"\n"
"while True:\n"
"    p.freq(f)\n"
"\n"
"    sleep(10 / F_MIN)\n"
"\n"
"    f += delta_f\n"
"    if f >= F_MAX or f <= F_MIN:\n"
"        delta_f = -delta_f"
msgstr ""

#: ../../esp32/tutorial/pwm.rst:74 ../../esp32/tutorial/pwm.rst:102
msgid "See PWM wave at Pin(5) with an oscilloscope."
msgstr "オシロスコープで Pin(5) の PWM 波形を見てみてください。"

#: ../../esp32/tutorial/pwm.rst:76
msgid "Example of a smooth duty change::"
msgstr "スムーズなデューティ変更の例::"

#: ../../esp32/tutorial/pwm.rst:78
msgid ""
"from utime import sleep\n"
"from machine import Pin, PWM\n"
"\n"
"DUTY_MAX = 2**16 - 1\n"
"\n"
"duty_u16 = 0\n"
"delta_d = 16\n"
"\n"
"p = PWM(Pin(5), 1000, duty_u16=duty_u16)\n"
"print(p)\n"
"\n"
"while True:\n"
"    p.duty_u16(duty_u16)\n"
"\n"
"    sleep(1 / 1000)\n"
"\n"
"    duty_u16 += delta_d\n"
"    if duty_u16 >= DUTY_MAX:\n"
"        duty_u16 = DUTY_MAX\n"
"        delta_d = -delta_d\n"
"    elif duty_u16 <= 0:\n"
"        duty_u16 = 0\n"
"        delta_d = -delta_d"
msgstr ""

#: ../../esp32/tutorial/pwm.rst:104
msgid ""
"Note: the Pin.OUT mode does not need to be specified.  The channel is "
"initialized to PWM mode internally once for each Pin that is passed to "
"the PWM constructor."
msgstr ""
"注記: Pin.OUT モードを指定する必要はありません。"
"チャネルは、PWM コンストラクターに渡されるピンごとに1回、"
"内部的に PWM モードに初期化されます。"

#: ../../esp32/tutorial/pwm.rst:107
msgid "The following code is wrong::"
msgstr "次のコードは間違いです::"

#: ../../esp32/tutorial/pwm.rst:109
msgid ""
"pwm = PWM(Pin(5, Pin.OUT), freq=1000, duty=512)  # Pin(5) in PWM mode "
"here\n"
"pwm = PWM(Pin(5, Pin.OUT), freq=500, duty=256)  # Pin(5) in OUT mode "
"here, PWM is off"
msgstr ""
"pwm = PWM(Pin(5, Pin.OUT), freq=1000, duty=512)  # ここで Pin(5) が PWM モードなるが...\n"
"pwm = PWM(Pin(5, Pin.OUT), freq=500, duty=256)  # ここで Pin(5) が OUT モードになり、PWM が無効になる"


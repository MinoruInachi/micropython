"\n"
"rtc = RTC()\n"
"rtc.datetime((2017, 8, 23, 0, 1, 12, 48, 0)) # 指定の日時を設定\n"
"                                             # 2017/8/23 1:12:48\n"
"                                             # 曜日の値は無視される\n"
"rtc.datetime() # 日時を取得"

#: ../../esp32/quickref.rst:743

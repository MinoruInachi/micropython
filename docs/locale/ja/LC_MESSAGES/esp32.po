#: ../../esp32/tutorial/pwm.rst:109
msgid "Example of a **smooth duty change**::"
msgstr "**スムーズなデューティ変更** の例::"

#: ../../esp32/tutorial/pwm.rst:111
msgid ""
"from time import sleep\n"
"from machine import Pin, PWM\n"
"\n"
"DUTY_MAX = 65535\n"
"\n"
"duty_u16 = 0\n"
"delta_d = 256\n"
"\n"
"pwm = PWM(Pin(27), freq=1000, duty_u16=duty_u16)\n"
"\n"
"while True:\n"
"    pwm.duty_u16(duty_u16)\n"
"    sleep(2 / pwm.freq())\n"
"    print(pwm)\n"
"\n"
"    if duty_u16 >= DUTY_MAX:\n"
"        print()\n"
"        sleep(2)\n"
"    elif duty_u16 <= 0:\n"
"        print()\n"
"        sleep(2)\n"
"\n"
"    duty_u16 += delta_d\n"
"    if duty_u16 >= DUTY_MAX:\n"
"        duty_u16 = DUTY_MAX\n"
"        delta_d = -delta_d\n"
"    elif duty_u16 <= 0:\n"
"        duty_u16 = 0\n"
"        delta_d = -delta_d"
msgstr ""


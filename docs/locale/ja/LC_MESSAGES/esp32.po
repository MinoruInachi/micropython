#: ../../esp32/quickref.rst:454
msgid "I2S bus"
msgstr "I2S バス"

#: ../../esp32/quickref.rst:458
msgid "See :ref:`machine.I2S <machine.I2S>`. ::"
msgstr ":ref:`machine.I2S <machine.I2S>` を参照。"

#: ../../esp32/quickref.rst:421
msgid ""
"from machine import I2S, Pin\n"
"\n"
"i2s = I2S(0, sck=Pin(13), ws=Pin(14), sd=Pin(34), mode=I2S.TX, bits=16, "
"format=I2S.STEREO, rate=44100, ibuf=40000) # create I2S object\n"
"i2s.write(buf)             # write buffer of audio samples to I2S device\n"
"\n"
"i2s = I2S(1, sck=Pin(33), ws=Pin(25), sd=Pin(32), mode=I2S.RX, bits=16, "
"format=I2S.MONO, rate=22050, ibuf=40000) # create I2S object\n"
"i2s.readinto(buf)          # fill buffer with audio samples from I2S "
"device"
msgstr ""
"from machine import I2S, Pin\n"
"\n"
"i2s = I2S(0, sck=Pin(13), ws=Pin(14), sd=Pin(34), mode=I2S.TX, bits=16, "
"format=I2S.STEREO, rate=44100, ibuf=40000) # create I2S object\n"
"i2s.write(buf)             # オーディオサンプルのバッファを I2S デバイスに書き出す\n"
"\n"
"i2s = I2S(1, sck=Pin(33), ws=Pin(25), sd=Pin(32), mode=I2S.RX, bits=16, "
"format=I2S.MONO, rate=22050, ibuf=40000) # create I2S object\n"
"i2s.readinto(buf)          # I2S デバイスからのオーディオサンプルをバッファに読み込む"

#: ../../esp32/quickref.rst:466

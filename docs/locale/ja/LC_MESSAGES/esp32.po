#: ../../esp32/tutorial/pwm.rst:169
msgid "Example of a **smooth duty change and PWM output inversion**::"
msgstr "**スムーズなデューティ変更と PWM 出力反転** の例::"

#: ../../esp32/tutorial/pwm.rst:171
msgid ""
"from utime import sleep\n"
"from machine import Pin, PWM\n"
"\n"
"try:\n"
"    DUTY_MAX = 65535\n"
"\n"
"    duty_u16 = 0\n"
"    delta_d = 65536 // 32\n"
"\n"
"    pwm = PWM(Pin(27))\n"
"    pwmi = PWM(Pin(32), invert=1)\n"
"\n"
"    while True:\n"
"        pwm.duty_u16(duty_u16)\n"
"        pwmi.duty_u16(duty_u16)\n"
"\n"
"        duty_u16 += delta_d\n"
"        if duty_u16 >= DUTY_MAX:\n"
"            duty_u16 = DUTY_MAX\n"
"            delta_d = -delta_d\n"
"        elif duty_u16 <= 0:\n"
"            duty_u16 = 0\n"
"            delta_d = -delta_d\n"
"\n"
"        sleep(.01)\n"
"        print(pwm)\n"
"        print(pwmi)\n"
"\n"
"finally:\n"
"    try:\n"
"        pwm.deinit()\n"
"    except:\n"
"        pass\n"
"    try:\n"
"        pwmi.deinit()\n"
"    except:\n"
"        pass"
msgstr ""


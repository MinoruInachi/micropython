msgstr ":ref:`machine.RTC <machine.RTC>` を参照::"

#: ../../esp32/quickref.rst:734
msgid ""
"from machine import RTC\n"
"\n"
"rtc = RTC()\n"
"rtc.datetime((2017, 8, 23, 0, 1, 12, 48, 0)) # set a specific date and\n"

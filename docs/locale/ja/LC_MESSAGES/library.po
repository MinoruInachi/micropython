msgstr "I2S バス初期化時に ``format`` をステレオにするためのものです"

#: ../../library/machine.I2S.rst:164
msgid "for initialising the I2S bus ``format`` to mono"
msgstr "I2S バス初期化時に ``format`` をモノラルにするためのものです"

#: ../../library/machine.PWM.rst:5
msgid "class PWM -- pulse width modulation"
msgstr "クラス PWM -- パルス幅変調"

#: ../../library/machine.PWM.rst:7
msgid "This class provides pulse width modulation output."
msgstr "このクラスはパルス幅変調出力を提供します。"

#: ../../library/machine.PWM.rst:11
msgid ""
"from machine import PWM\n"
"\n"
"pwm = PWM(pin, freq=50, duty_u16=8192)  # create a PWM object on a pin\n"
"                                        # and set freq and duty\n"
"pwm.duty_u16(32768)     # set duty to 50%\n"
"\n"
"# reinitialise with a period of 200us, duty of 5us\n"
"pwm.init(freq=5000, duty_ns=5000)\n"
"\n"
"pwm.duty_ns(3000)       # set pulse width to 3us\n"
"\n"
"pwm.deinit()"
msgstr ""
"from machine import PWM\n"
"\n"
"pwm = PWM(pin, freq=50, duty_u16=8192)  # ピンの PWM オブジェクトを作成し、\n"
"                                        # 周波数とパルス幅を設定\n"
"pwm = PWM(pin)          # 指定のピンの PWM オブジェクトを作成\n"
"pwm.duty_u16(32768)     # パルス幅を 50% に設定\n"
"\n"
"# 200us の周期、デューティ比を 5us で再初期化\n"
"pwm.init(freq=5000, duty_ns=5000)\n"
"\n"
"pwm.duty_ns(3000)       # 3us のデューティ比を設定\n"
"\n"
"pwm.deinit()"


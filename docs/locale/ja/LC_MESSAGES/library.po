">>> e.peers_table\n"
"{b'\\xaa\\xaa\\xaa\\xaa\\xaa\\xaa': [-31, 18372],\n"
" b'\\xbb\\xbb\\xbb\\xbb\\xbb\\xbb': [-43, 12541]}"
msgstr ""


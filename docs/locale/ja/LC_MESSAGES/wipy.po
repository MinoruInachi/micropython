#: ../../wipy/tutorial/timer.rst:2
msgid "Hardware timers"
msgstr "ハードウェアタイマー"

#: ../../wipy/tutorial/timer.rst:4
msgid "Timers can be used for a great variety of tasks, calling a function periodically, counting events, and generating a PWM signal are among the most common use cases. Each timer consists of two 16-bit channels and this channels can be tied together to form one 32-bit timer. The operating mode needs to be configured per timer, but then the period (or the frequency) can be independently configured on each channel. By using the callback method, the timer event can call a Python function."
msgstr "タイマーは非常にさまざまな用途に使えます。関数を定期的に呼び出す、イベントを数える、PWM 信号を生成するといった使い方が最も一般的です。各タイマーは2つの16ビットチャネルからなり、これらのチャネルを組み合わせて1つの32ビットタイマーにできます。動作モードはタイマーごとに設定する必要がありますが、周期(または周波数)はチャネルごとに独立して設定できます。callback メソッドを使えば、タイマーのイベントから Python の関数を呼び出せます。"

#: ../../wipy/tutorial/timer.rst:11
msgid "Example usage to toggle an LED at a fixed frequency::"
msgstr "一定の周波数で LED を切り替える使用例::"

#: ../../wipy/tutorial/timer.rst:13
msgid ""
"from machine import Timer\n"
"from machine import Pin\n"
"led = Pin('GP16', mode=Pin.OUT)                  # enable GP16 as output to drive the LED\n"
"tim = Timer(3)                                   # create a timer object using timer 3\n"
"tim.init(mode=Timer.PERIODIC)                    # initialize it in periodic mode\n"
"tim_ch = tim.channel(Timer.A, freq=5)            # configure channel A at a frequency of 5Hz\n"
"tim_ch.irq(handler=lambda t:led.toggle(), trigger=Timer.TIMEOUT)        # toggle a LED on every cycle of the timer"
msgstr ""
"from machine import Timer\n"
"from machine import Pin\n"
"led = Pin('GP16', mode=Pin.OUT)                  # LED を駆動するため GP16 を出力にします\n"
"tim = Timer(3)                                   # タイマー3を使って timer オブジェクトを作成\n"
"tim.init(mode=Timer.PERIODIC)                    # 周期モードで初期化\n"
"tim_ch = tim.channel(Timer.A, freq=5)            # チャネル A を周波数 5Hz で設定\n"
"tim_ch.irq(handler=lambda t:led.toggle(), trigger=Timer.TIMEOUT)        # タイマーの周期ごとに LED を切り替え"

#: ../../wipy/tutorial/timer.rst:21
msgid "Example using named function for the callback::"
msgstr "コールバックに名前付き関数を使う例::"

#: ../../wipy/tutorial/timer.rst:23
msgid ""
"from machine import Timer\n"
"from machine import Pin\n"
"tim = Timer(1, mode=Timer.PERIODIC, width=32)\n"
"tim_a = tim.channel(Timer.A | Timer.B, freq=1)   # 1 Hz frequency requires a 32 bit timer\n"
"\n"
"led = Pin('GP16', mode=Pin.OUT) # enable GP16 as output to drive the LED\n"
"\n"
"def tick(timer):                # we will receive the timer object when being called\n"
"    global led\n"
"    led.toggle()                # toggle the LED\n"
"\n"
"tim_a.irq(handler=tick, trigger=Timer.TIMEOUT)         # create the interrupt"
msgstr ""
"from machine import Timer\n"
"from machine import Pin\n"
"tim = Timer(1, mode=Timer.PERIODIC, width=32)\n"
"tim_a = tim.channel(Timer.A | Timer.B, freq=1)   # 1 Hz の周波数には 32 ビットタイマーが必要です\n"
"\n"
"led = Pin('GP16', mode=Pin.OUT) # LED を駆動するため GP16 を出力にします\n"
"\n"
"def tick(timer):                # 呼び出されるときに timer オブジェクトを受け取ります\n"
"    global led\n"
"    led.toggle()                # LED を切り替え\n"
"\n"
"tim_a.irq(handler=tick, trigger=Timer.TIMEOUT)         # 割り込みを作成"

#: ../../wipy/tutorial/timer.rst:36
msgid "Further examples::"
msgstr "さらに別の例::"

#: ../../wipy/tutorial/timer.rst:38
#, python-format
msgid ""
"from machine import Timer\n"
"tim1 = Timer(1, mode=Timer.ONE_SHOT)                               # initialize it in one shot mode\n"
"tim2 = Timer(2, mode=Timer.PWM)                                    # initialize it in PWM mode\n"
"tim1_ch = tim1.channel(Timer.A, freq=10, polarity=Timer.POSITIVE)  # start the event counter with a frequency of 10Hz and triggered by positive edges\n"
"tim2_ch = tim2.channel(Timer.B, freq=10000, duty_cycle=5000)       # start the PWM on channel B with a 50% duty cycle\n"
"tim2_ch.freq(20)                                                   # set the frequency (can also get)\n"
"tim2_ch.duty_cycle(3010)                                           # set the duty cycle to 30.1% (can also get)\n"
"tim2_ch.duty_cycle(3020, Timer.NEGATIVE)                           # set the duty cycle to 30.2% and change the polarity to negative\n"
"tim2_ch.period(2000000)                                            # change the period to 2 seconds"
msgstr ""
"from machine import Timer\n"
"tim1 = Timer(1, mode=Timer.ONE_SHOT)                               # ワンショットモードで初期化\n"
"tim2 = Timer(2, mode=Timer.PWM)                                    # PWM モードで初期化\n"
"tim1_ch = tim1.channel(Timer.A, freq=10, polarity=Timer.POSITIVE)  # 周波数 10Hz、立ち上がりエッジをトリガとしてイベントカウンタを開始\n"
"tim2_ch = tim2.channel(Timer.B, freq=10000, duty_cycle=5000)       # チャネル B でデューティサイクル 50% の PWM を開始\n"
"tim2_ch.freq(20)                                                   # 周波数を設定(取得も可能)\n"
"tim2_ch.duty_cycle(3010)                                           # デューティサイクルを 30.1% に設定(取得も可能)\n"
"tim2_ch.duty_cycle(3020, Timer.NEGATIVE)                           # デューティサイクルを 30.2% に設定し、極性を負に変更\n"
"tim2_ch.period(2000000)                                            # 周期を 2 秒に変更"


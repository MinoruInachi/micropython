"i2c.readfrom(0x42, 5) # ペリフェラルから 5 バイト受信\n"
"i2c.readfrom_mem(0x42, 0x10, 2) # ペリフェラル 0x42 のメモリ 0x10 から 2 バイト読み込み\n"
"i2c.writeto_mem(0x42, 0x10, 'xy') # ペリフェラル 0x42 のメモリ 0x10 に 2 バイト書き出し"


#: ../../wipy/tutorial/wlan.rst:50
msgid "If you want your WiPy to connect to your home router after boot-up, and with a fixed IP address so that you can access it via telnet or FTP, use the following script as /flash/boot.py::"
msgstr "起動後に WiPy を自宅のルーターへ接続させ、telnet や FTP でアクセスできるように固定 IP アドレスを割り当てたい場合は、次のスクリプトを /flash/boot.py として使ってください::"

#: ../../wipy/tutorial/wlan.rst:53
msgid ""
"import machine, network\n"
"from network import WLAN\n"
"wlan = WLAN() # get current object, without changing the mode\n"
"\n"
"if machine.reset_cause() != machine.SOFT_RESET:\n"
"    wlan.init(WLAN.STA)\n"
"    # configuration below MUST match your home router settings!!\n"
"    network.ipconfig(dns='8.8.8.8')\n"
"    wlan.ipconfig(addr4='192.168.0.107/24', gw4='192.168.0.1')\n"
"\n"
"if not wlan.isconnected():\n"
"    # change the line below to match your network ssid, security and password\n"
"    wlan.connect('mywifi', auth=(WLAN.WPA2, 'mywifikey'), timeout=5000)\n"
"    while not wlan.isconnected():\n"
"        machine.idle() # save power while waiting"
msgstr ""
"import machine, network\n"
"from network import WLAN\n"
"wlan = WLAN() # モードを変更せずに現在のオブジェクトを取得\n"
"\n"
"if machine.reset_cause() != machine.SOFT_RESET:\n"
"    wlan.init(WLAN.STA)\n"
"    # 以下の設定は自宅のルーターの設定と一致していなければなりません!!\n"
"    network.ipconfig(dns='8.8.8.8')\n"
"    wlan.ipconfig(addr4='192.168.0.107/24', gw4='192.168.0.1')\n"
"\n"
"if not wlan.isconnected():\n"
"    # 以下の行を自分のネットワークの ssid、セキュリティ、パスワードに合わせて変更してください\n"
"    wlan.connect('mywifi', auth=(WLAN.WPA2, 'mywifikey'), timeout=5000)\n"
"    while not wlan.isconnected():\n"
"        machine.idle() # 待っている間の電力を節約"

#: ../../wipy/tutorial/wlan.rst:71
msgid "Notice how we check for the reset cause and the connection status, this is crucial in order to be able to soft reset the WiPy during a telnet session without breaking the connection."
msgstr "リセット要因と接続状態を確認している点に注目してください。これは、telnet セッション中に接続を切らずに WiPy をソフトリセットできるようにするために重要です。"


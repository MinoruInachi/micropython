msgstr "リアルタイムクロック (RTC)"

#: ../../wipy/quickref.rst:145
msgid "See :ref:`machine.RTC <machine.RTC>` ::"
msgstr ":ref:`machine.RTC <machine.RTC>` を参照してください ::"

#: ../../wipy/quickref.rst:147
msgid ""
"from machine import RTC\n"
"\n"
"rtc = RTC() # init with default time and date\n"
"rtc = RTC(datetime=(2015, 8, 29, 9, 0, 0, 0, None)) # init with a specific time and date\n"
"print(rtc.now())\n"
"\n"
"def alarm_handler (rtc_o):\n"
"    pass\n"
"    # do some non blocking operations\n"
"    # warning printing on an irq via telnet is not\n"
"    # possible, only via UART\n"
"\n"
"# create a RTC alarm that expires after 5 seconds\n"
"rtc.alarm(time=5000, repeat=False)\n"
"\n"
"# enable RTC interrupts\n"
"rtc_i = rtc.irq(trigger=RTC.ALARM0, handler=alarm_handler, wake=machine.SLEEP)\n"
"\n"
"# go into suspended mode waiting for the RTC alarm to expire and wake us up\n"
"machine.lightsleep()"
msgstr ""
"from machine import RTC\n"
"\n"
"rtc = RTC() # デフォルトの時刻と日付で初期化\n"
"rtc = RTC(datetime=(2015, 8, 29, 9, 0, 0, 0, None)) # 特定の時刻と日付で初期化\n"
"print(rtc.now())\n"
"\n"
"def alarm_handler (rtc_o):\n"
"    pass\n"
"    # ブロックしない処理を行います\n"
"    # 注意: irq の中から telnet 経由で表示することはできません。\n"
"    # UART 経由でのみ可能です\n"
"\n"
"# 5 秒後に切れる RTC アラームを作成\n"
"rtc.alarm(time=5000, repeat=False)\n"
"\n"
"# RTC 割り込みを有効化\n"
"rtc_i = rtc.irq(trigger=RTC.ALARM0, handler=alarm_handler, wake=machine.SLEEP)\n"
"\n"
"# RTC アラームが切れて復帰させてくれるのを待つサスペンドモードに入ります\n"
"machine.lightsleep()"

#: ../../wipy/quickref.rst:169
msgid "SD card"
msgstr "SD カード"

#: ../../wipy/quickref.rst:171
msgid "See :ref:`machine.SD <machine.SD>`. ::"
msgstr ":ref:`machine.SD <machine.SD>` を参照してください。 ::"


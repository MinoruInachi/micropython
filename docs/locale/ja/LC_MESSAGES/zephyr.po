#: ../../zephyr/quickref.rst:136 ../../zephyr/tutorial/storage.rst:33
msgid "Disk Access"
msgstr "ディスクアクセス"

#: ../../zephyr/quickref.rst:138
msgid ""
"Storage devices such as SD cards are automatically mounted at startup "
"(e.g., at ``/sd``). For manual mounting, use the :ref:`zephyr.DiskAccess "
"<zephyr.DiskAccess>` class::"
msgstr ""
"SDカードなどのストレージデバイスは、起動時に自動的にマウントされます(例: ``/sd``)。"
"手動でマウントするには :ref:`zephyr.DiskAccess <zephyr.DiskAccess>` クラスを"
"使います::"

#: ../../zephyr/quickref.rst:141
msgid ""
"import vfs\n"
"from zephyr import DiskAccess\n"
"\n"
"print(DiskAccess.disks)             # list available disk names, e.g., "
"('SDHC',)\n"
"\n"
"block_dev = DiskAccess('SDHC')      # create a block device object for an"
" SD card\n"
"vfs.VfsFat.mkfs(block_dev)          # create FAT filesystem object using "
"the disk storage block\n"
"vfs.mount(block_dev, '/sd')         # mount the filesystem at the SD card"
" subdirectory\n"
"\n"
"# with the filesystem mounted, files can be manipulated as normal\n"
"with open('/sd/hello.txt','w') as f:     # open a new file in the "
"directory\n"
"    f.write('Hello world')                  # write to the file\n"
"print(open('/sd/hello.txt').read())      # print contents of the file"
msgstr ""
"import vfs\n"
"from zephyr import DiskAccess\n"
"\n"
"print(DiskAccess.disks)             # 利用可能なディスク名のリスト。例: ('SDHC',)\n"
"\n"
"block_dev = DiskAccess('SDHC')      # SDカード用のブロックデバイスオブジェクトを作成\n"
"vfs.VfsFat.mkfs(block_dev)          # ディスクストレージブロックを用いて FAT ファイルシステムオブジェクトを作成\n"
"vfs.mount(block_dev, '/sd')         # SD カード用のサブディレクトリにファイルシステムをマウント\n"
"\n"
"# マウントしたファイルシステムでは、普通にファイル操作が可能\n"
"with open('/sd/hello.txt','w') as f:     # ディレクトリ中に新しいファイルをオープン\n"
"    f.write('Hello world')                  # ファイルに書き出し\n"
"print(open('/sd/hello.txt').read())      # ファイルの内容を表示"

#: ../../zephyr/quickref.rst:156 ../../zephyr/tutorial/storage.rst:65
msgid "Flash Area"
msgstr "フラッシュ領域"

#: ../../zephyr/quickref.rst:158
msgid ""
"Flash storage is automatically mounted at ``/flash`` at startup with "
"automatic filesystem creation. For manual mounting, use the "
":ref:`zephyr.FlashArea <zephyr.FlashArea>` class::"
msgstr ""
"フラッシュストレージは起動時に ``/flash`` へ自動的にマウントされ、"
"ファイルシステムも自動的に作成されます。手動でマウントする場合は "
":ref:`zephyr.FlashArea <zephyr.FlashArea>` クラスを使ってください。"

#: ../../zephyr/quickref.rst:144
msgid ""
"import vfs\n"
"from zephyr import FlashArea\n"
"\n"
"print(FlashArea.areas)              # list available areas, e.g., "
"{'storage': 1, 'scratch': 4}\n"
"\n"
"block_dev = FlashArea(FlashArea.areas['scratch'], 4096)  # creates a "
"the frdm-k64f flash scratch partition\n"
"vfs.VfsLfs2.mkfs(block_dev)         # create filesystem in lfs2 format "
"using the flash block device\n"
"vfs.mount(block_dev, '/flash')      # mount the filesystem at the flash "
"subdirectory\n"
"\n"
"# with the filesystem mounted, files can be manipulated as normal\n"
"with open('/flash/hello.txt','w') as f:     # open a new file in the "
"directory\n"
"    f.write('Hello world')                  # write to the file\n"
"print(open('/flash/hello.txt').read())      # print contents of the file"
msgstr ""
"import vfs\n"
"from zephyr import FlashArea\n"
"\n"
"print(FlashArea.areas)              # 利用可能な領域のリスト。例: {'storage': 1, 'scratch': 4}\n"
"\n"
"block_dev = FlashArea(FlashArea.areas['scratch'], 4096)  # スクラッチパーティションにブロックデバイスオブジェクトを作成\n"
"vfs.VfsLfs2.mkfs(block_dev)         # フラッシュブロックデバイスを使って、lfs2フォーマットでファイルシステムを作成\n"
"vfs.mount(block_dev, '/flash')      # フラッシュ用のサブディレクトリにファイルシステムをマウント\n"
"\n"
"# マウントしたファイルシステムでは、普通にファイル操作が可能\n"
"with open('/flash/hello.txt','w') as f:     # ディレクトリ中に新しいファイルをオープン\n"
"    f.write('Hello world')                  # ファイルに書き出し\n"
"print(open('/flash/hello.txt').read())      # ファイルの内容を表示"

#: ../../zephyr/quickref.rst:176
msgid "Sensor"
msgstr "センサー"

#: ../../zephyr/quickref.rst:178
msgid ""
"Use the :ref:`zsensor.Sensor <zsensor.Sensor>` class to access sensor "
"data::"
msgstr ""
"センサーデータにアクセスするには "
":ref:`zsensor.Sensor <zsensor.Sensor>` クラスを使います::"

#: ../../zephyr/quickref.rst:180
msgid ""
"import zsensor\n"
"from zsensor import Sensor\n"
"\n"
"accel = Sensor(\"fxos8700\")    # create sensor object for the "
"accelerometer\n"
"\n"
"accel.measure()               # obtain a measurement reading from the "
"accelerometer\n"
"\n"
"# each of these prints the value taken by measure()\n"
"accel.get_float(zsensor.ACCEL_X)  # print measurement value for "
"accelerometer X-axis sensor channel as float\n"
"accel.get_millis(zsensor.ACCEL_Y) # print measurement value for "
"accelerometer Y-axis sensor channel in millionths\n"
"accel.get_micro(zsensor.ACCEL_Z)  # print measurement value for "
"accelerometer Z-axis sensor channel in thousandths\n"
"accel.get_int(zsensor.ACCEL_X)    # print measurement integer value only "
"for accelerometer X-axis sensor channel"
msgstr ""
"import zsensor\n"
"from zsensor import Sensor\n"
"\n"
"accel = Sensor(\"fxos8700\")    # 加速度センサーのセンサーオブジェクトを作成\n"
"\n"
"accel.measure()               # 加速度センサーから読み込んだ計測データを取得\n"
"\n"
"# 以下は measure() で取得した値を表示\n"
"accel.get_float(zsensor.ACCEL_X)  # 加速度センサーのX軸センサーチャンネル計測値を float で表示\n"
"accel.get_millis(zsensor.ACCEL_Y) # 加速度センサーのY軸センサーチャンネル計測値を100万分の1単位で表示\n"
"accel.get_micro(zsensor.ACCEL_Z)  # 加速度センサーのY軸センサーチャンネル計測値を1000分の1単位で表示\n"
"accel.get_int(zsensor.ACCEL_X)    # 加速度センサーのX軸センサーチャンネル計測値を int で表示"

#: ../../zephyr/quickref.rst:193
msgid ""
"The channel IDs that are used as arguments to the "
":meth:`zsensor.Sensor.get_int`, :meth:`zsensor.Sensor.get_float()`, "
":meth:`zsensor.Sensor.get_millis()`, and "
":meth:`zsensor.Sensor.get_micros()` methods are constants in the "
":mod:`zsensor` module."
msgstr ""
":meth:`zsensor.Sensor.get_int`, :meth:`zsensor.Sensor.get_float()`, "
":meth:`zsensor.Sensor.get_millis()`, :meth:`zsensor.Sensor.get_micros()` "
"メソッドの引数として使われるチャンネルIDは :mod:`zsensor` モジュール内の定数です。"

#: ../../zephyr/quickref.rst:197
msgid ""
"You can use the :meth:`zsensor.Sensor.attr_set` method to set sensor "
"attributes like full-scale range and update rate::"
msgstr ""
":meth:`zsensor.Sensor.attr_set` メソッドを使用使って、フルスケール範囲や"
"更新レートなどのセンサー属性を設定できます。"

#: ../../zephyr/quickref.rst:200
msgid ""
"# Example for XIAO BLE NRF52840 SENSE\n"
"from zsensor import *\n"
"accel = Sensor('lsm6ds3tr_c')  # name from Devicetree\n"
"# Set full-scale to 2g (19.613300 m/sec^2)\n"
"# units are micro-m/s^2 (given as a float)\n"
"accel.attr_set(ACCEL_XYZ, ATTR_FULL_SCALE, 19.613300)\n"
"# Set sampling frequency to 104 Hz (as a pair of integers)\n"
"accel.attr_set(ACCEL_XYZ, ATTR_SAMPLING_FREQUENCY, 104, 0)\n"
"accel.measure()\n"
"accel.get_float(ACCEL_X) # -0.508 (m/s^2)\n"
"accel.get_float(ACCEL_Y) # -3.62 (m/s^2)\n"
"accel.get_float(ACCEL_Z) # 9.504889 (m/s^2)"
msgstr ""
"# XIAO BLE NRF52840 SENSE の例\n"
"from zsensor import *\n"
"accel = Sensor('lsm6ds3tr_c')  # name from Devicetree\n"
"# Set full-scale to 2g (19.613300 m/sec^2)\n"
"# units are micro-m/s^2 (given as a float)\n"
"accel.attr_set(ACCEL_XYZ, ATTR_FULL_SCALE, 19.613300)\n"
"# Set sampling frequency to 104 Hz (as a pair of integers)\n"
"accel.attr_set(ACCEL_XYZ, ATTR_SAMPLING_FREQUENCY, 104, 0)\n"
"accel.measure()\n"
"accel.get_float(ACCEL_X) # -0.508 (m/s^2)\n"
"accel.get_float(ACCEL_Y) # -3.62 (m/s^2)\n"
"accel.get_float(ACCEL_Z) # 9.504889 (m/s^2)"


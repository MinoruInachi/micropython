#: ../../zephyr/quickref.rst:20
msgid "Delay and timing"
msgstr ""

#: ../../zephyr/quickref.rst:22
msgid "Use the :mod:`time <utime>` module::"
msgstr ""

#: ../../zephyr/quickref.rst:24
msgid ""
"import time\n"
"\n"
"time.sleep(1)               # sleep for 1 second\n"
"time.sleep_ms(500)          # sleep for 500 milliseconds\n"
"time.sleep_us(10)           # sleep for 10 microseconds\n"
"start = time.ticks_ms()     # get millisecond counter\n"
"delta = time.ticks_diff(time.ticks_ms(), start) # compute time difference"
msgstr ""

#: ../../zephyr/quickref.rst:33
msgid "Pins and GPIO"
msgstr ""

#: ../../zephyr/quickref.rst:35
msgid "Use the :ref:`machine.Pin <machine.Pin>` class::"
msgstr ""

#: ../../zephyr/quickref.rst:37
msgid ""
"from machine import Pin\n"
"\n"
"pin = Pin((\"GPIO_1\", 21), Pin.IN)   # create input pin on GPIO1\n"
"print(pin)                          # print pin port and number\n"
"\n"
"pin.init(Pin.OUT, Pin.PULL_UP, value=1)     # reinitialize pin\n"
"\n"
"pin.value(1)                        # set pin to high\n"
"pin.value(0)                        # set pin to low\n"
"\n"
"pin.on()                            # set pin to high\n"
"pin.off()                           # set pin to low\n"
"\n"
"pin = Pin((\"GPIO_1\", 21), Pin.IN)   # create input pin on GPIO1\n"
"\n"
"pin = Pin((\"GPIO_1\", 21), Pin.OUT, value=1)         # set pin high on "
"creation\n"
"\n"
"pin = Pin((\"GPIO_1\", 21), Pin.IN, Pin.PULL_UP)      # enable internal "
"pull-up resistor\n"
"\n"
"switch = Pin((\"GPIO_2\", 6), Pin.IN)                 # create input pin "
"for a switch\n"
"switch.irq(lambda t: print(\"SW2 changed\"))          # enable an "
"interrupt when switch state is changed"
msgstr ""

#: ../../zephyr/quickref.rst:60
msgid "Hardware I2C bus"
msgstr ""

#: ../../zephyr/quickref.rst:62
msgid "Hardware I2C is accessed via the :ref:`machine.I2C <machine.I2C>` class::"
msgstr ""

#: ../../zephyr/quickref.rst:64
msgid ""
"from machine import I2C\n"
"\n"
"i2c = I2C(\"I2C_0\")          # construct an i2c bus\n"
"print(i2c)                  # print device name\n"
"\n"
"i2c.scan()                  # scan the device for available I2C slaves\n"
"\n"
"i2c.readfrom(0x1D, 4)                # read 4 bytes from slave 0x1D\n"
"i2c.readfrom_mem(0x1D, 0x0D, 1)      # read 1 byte from slave 0x1D at "
"slave memory 0x0D\n"
"\n"
"i2c.writeto(0x1D, b'abcd')           # write to slave with address 0x1D\n"
"i2c.writeto_mem(0x1D, 0x0D, b'ab')   # write to slave 0x1D at slave "
"memory 0x0D\n"
"\n"
"buf = bytearray(8)                  # create buffer of size 8\n"
"i2c.writeto(0x1D, b'abcd')          # write buf to slave 0x1D"
msgstr ""

#: ../../zephyr/quickref.rst:81
msgid "Hardware SPI bus"
msgstr ""

#: ../../zephyr/quickref.rst:83
msgid "Hardware SPI is accessed via the :ref:`machine.SPI <machine.SPI>` class::"
msgstr ""

#: ../../zephyr/quickref.rst:85
msgid ""
"from machine import SPI\n"
"\n"
"spi = SPI(\"SPI_0\")          # construct a spi bus with default "
"configuration\n"
"spi.init(baudrate=100000, polarity=0, phase=0, bits=8, firstbit=SPI.MSB) "
"# set configuration\n"
"\n"
"# equivalently, construct spi bus and set configuration at the same time\n"
"spi = SPI(\"SPI_0\", baudrate=100000, polarity=0, phase=0, bits=8, "
"firstbit=SPI.MSB)\n"
"print(spi)                  # print device name and bus configuration\n"
"\n"
"spi.read(4)                 # read 4 bytes on MISO\n"
"spi.read(4, write=0xF)      # read 4 bytes while writing 0xF on MOSI\n"
"\n"
"buf = bytearray(8)          # create a buffer of size 8\n"
"spi.readinto(buf)           # read into the buffer (reads number of bytes"
" equal to the buffer size)\n"
"spi.readinto(buf, 0xF)      # read into the buffer while writing 0xF on "
"MOSI\n"
"\n"
"spi.write(b'abcd')          # write 4 bytes on MOSI\n"
"\n"
"buf = bytearray(4)                  # create buffer of size 8\n"
"spi.write_readinto(b'abcd', buf)    # write to MOSI and read from MISO "
"into the buffer\n"
"spi.write_readinto(buf, buf)        # write buf to MOSI and read back "
"into the buf"
msgstr ""

#: ../../zephyr/quickref.rst:108 ../../zephyr/tutorial/storage.rst:12
msgid "Disk Access"
msgstr ""

#: ../../zephyr/quickref.rst:110
msgid ""
"Use the :ref:`zephyr.DiskAccess <zephyr.DiskAccess>` class to support "
"filesystem::"
msgstr ""

#: ../../zephyr/quickref.rst:112
msgid ""
"import os\n"
"from zephyr import DiskAccess\n"
"\n"
"block_dev = DiskAccess('SDHC')      # create a block device object for an"
" SD card\n"
"os.VfsFat.mkfs(block_dev)           # create FAT filesystem object using "
"the disk storage block\n"
"os.mount(block_dev, '/sd')          # mount the filesystem at the SD card"
" subdirectory\n"
"\n"
"# with the filesystem mounted, files can be manipulated as normal\n"
"with open('/sd/hello.txt','w') as f:     # open a new file in the "
"directory\n"
"    f.write('Hello world')                  # write to the file\n"
"print(open('/sd/hello.txt').read())      # print contents of the file"
msgstr ""

#: ../../zephyr/quickref.rst:125 ../../zephyr/tutorial/storage.rst:35
msgid "Flash Area"
msgstr ""

#: ../../zephyr/quickref.rst:127
msgid ""
"Use the :ref:`zephyr.FlashArea <zephyr.FlashArea>` class to support "
"filesystem::"
msgstr ""

#: ../../zephyr/quickref.rst:129
msgid ""
"import os\n"
"from zephyr import FlashArea\n"
"\n"
"block_dev = FlashArea(4, 4096)      # creates a block device object in "
"the frdm-k64f flash scratch partition\n"
"os.VfsLfs2.mkfs(block_dev)          # create filesystem in lfs2 format "
"using the flash block device\n"
"os.mount(block_dev, '/flash')       # mount the filesystem at the flash "
"subdirectory\n"
"\n"
"# with the filesystem mounted, files can be manipulated as normal\n"
"with open('/flash/hello.txt','w') as f:     # open a new file in the "
"directory\n"
"    f.write('Hello world')                  # write to the file\n"
"print(open('/flash/hello.txt').read())      # print contents of the file"
msgstr ""

#: ../../zephyr/quickref.rst:142
msgid "Sensor"
msgstr ""

#: ../../zephyr/quickref.rst:144
msgid ""
"Use the :ref:`zsensor.Sensor <zsensor.Sensor>` class to access sensor "
"data::"
msgstr ""

#: ../../zephyr/quickref.rst:146
msgid ""
"import zsensor\n"
"from zsensor import Sensor\n"
"\n"
"accel = Sensor(\"FXOX8700\")    # create sensor object for the "
"accelerometer\n"
"\n"
"accel.measure()               # obtain a measurement reading from the "
"accelerometer\n"
"\n"
"# each of these prints the value taken by measure()\n"
"accel.get_float(zsensor.ACCEL_X)  # print measurement value for "
"accelerometer X-axis sensor channel as float\n"
"accel.get_millis(zsensor.ACCEL_Y) # print measurement value for "
"accelerometer Y-axis sensor channel in millionths\n"
"accel.get_micro(zsensor.ACCEL_Z)  # print measurement value for "
"accelerometer Z-axis sensor channel in thousandths\n"
"accel.get_int(zsensor.ACCEL_X)    # print measurement integer value only "
"for accelerometer X-axis sensor channel"
msgstr ""


#: ../../genrst/builtin_types.rst:163
msgid ""
"OSError constructor returns a plain OSError for all errno values, rather "
"than a relevant subtype."
msgstr ""
"OSError コンストラクタは、関連するサブタイプではなく、すべての errno 値に対し"
"てそのままの OSError を返す"

#: ../../genrst/builtin_types.rst:165
msgid ""
"**Cause:** MicroPython does not include the CPython-standard OSError "
"subclasses."
msgstr ""
"**原因:** MicroPython には CPython 標準の OSError サブクラスが含まれていませ"
"ん。"

#: ../../genrst/builtin_types.rst:167
msgid ""
"**Workaround:** Catch OSError and use its errno attribute to discriminate "
"the cause."
msgstr ""
"**回避策:** OSError をキャッチし、その errno 属性を使って原因を特定してくださ"
"い。"

#: ../../genrst/builtin_types.rst:172
#, python-brace-format
msgid ""
"import errno\n"
"\n"
"errno_list = [  # i.e. the set implemented by micropython\n"
"    errno.EPERM,\n"
"    errno.ENOENT,\n"
"    errno.EIO,\n"
"    errno.EBADF,\n"
"    errno.EAGAIN,\n"
"    errno.ENOMEM,\n"
"    errno.EACCES,\n"
"    errno.EEXIST,\n"
"    errno.ENODEV,\n"
"    errno.EISDIR,\n"
"    errno.EINVAL,\n"
"    errno.EOPNOTSUPP,\n"
"    errno.EADDRINUSE,\n"
"    errno.ECONNABORTED,\n"
"    errno.ECONNRESET,\n"
"    errno.ENOBUFS,\n"
"    errno.ENOTCONN,\n"
"    errno.ETIMEDOUT,\n"
"    errno.ECONNREFUSED,\n"
"    errno.EHOSTUNREACH,\n"
"    errno.EALREADY,\n"
"    errno.EINPROGRESS,\n"
"]\n"
"\n"
"\n"
"def errno_output_type(n):\n"
"    try:\n"
"        raise OSError(n, \"\")\n"
"    except OSError as e:\n"
"        return f\"{type(e).__name__}\"\n"
"    except Exception as e:\n"
"        return f\"non-OSError {type(e).__name__}\"\n"
"    else:\n"
"        return \"no error\"\n"
"\n"
"\n"
"for n in errno_list:\n"
"    print(errno.errorcode[n], \"=\", errno_output_type(n))"
msgstr ""
"import errno\n"
"\n"
"errno_list = [  # つまり micropython が実装している集合\n"
"    errno.EPERM,\n"
"    errno.ENOENT,\n"
"    errno.EIO,\n"
"    errno.EBADF,\n"
"    errno.EAGAIN,\n"
"    errno.ENOMEM,\n"
"    errno.EACCES,\n"
"    errno.EEXIST,\n"
"    errno.ENODEV,\n"
"    errno.EISDIR,\n"
"    errno.EINVAL,\n"
"    errno.EOPNOTSUPP,\n"
"    errno.EADDRINUSE,\n"
"    errno.ECONNABORTED,\n"
"    errno.ECONNRESET,\n"
"    errno.ENOBUFS,\n"
"    errno.ENOTCONN,\n"
"    errno.ETIMEDOUT,\n"
"    errno.ECONNREFUSED,\n"
"    errno.EHOSTUNREACH,\n"
"    errno.EALREADY,\n"
"    errno.EINPROGRESS,\n"
"]\n"
"\n"
"\n"
"def errno_output_type(n):\n"
"    try:\n"
"        raise OSError(n, \"\")\n"
"    except OSError as e:\n"
"        return f\"{type(e).__name__}\"\n"
"    except Exception as e:\n"
"        return f\"non-OSError {type(e).__name__}\"\n"
"    else:\n"
"        return \"no error\"\n"
"\n"
"\n"
"for n in errno_list:\n"
"    print(errno.errorcode[n], \"=\", errno_output_type(n))"


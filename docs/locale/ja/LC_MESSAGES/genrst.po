"    print(\"Should have worked\")\n"
"try:\n"
"    print(eval(\"1or 0\"))\n"
"except SyntaxError:\n"
"    print(\"Should have worked\")\n"
"try:\n"
"    print(eval(\"1if 1else 0\"))\n"
"except SyntaxError:\n"
"    print(\"Should have worked\")\n"
"try:\n"
"    print(eval(\"0x1.to_bytes(1)\"))\n"
"except SyntaxError:\n"
"    print(\"Should have worked\")"

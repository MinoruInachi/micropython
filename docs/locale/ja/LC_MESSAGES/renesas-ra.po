"\n"
"i2c = I2C(0)\n"
"\n"
"i2c.scan()         # スレーブアドレスのリストを返す\n"
"i2c.readfrom_mem(0x50, 0x10, 2, addrsize=16)  # スレーブ 0x50、スレーブメモ"
"リ 0x10 から 2 バイト読込み"

